# GEMINI_API_KEY: Required if Gemini AI API calls are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Form endpoint (e.g., Formspree or Web3Forms) for direct contact form submission.
